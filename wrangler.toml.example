name = "dessert-box-ecommerce"
compatibility_date = "2024-04-01"
compatibility_flags = ["nodejs_compat"]
pages_build_output_dir = "dist"

# Jika sudah membuat D1 database di Cloudflare Dashboard / CLI,
# Anda bisa uncomment dan masukkan database_id yang sebenarnya:
# [[d1_databases]]
# binding = "DB"
# database_name = "dessert-box-db"
# database_id = "xxxx-xxxx-xxxx"
